CREATE TABLE IF NOT EXISTS customers (
    customer_id INTEGER PRIMARY KEY,
    customer_name VARCHAR(150) NOT NULL,
    email VARCHAR(255) NOT NULL,
    city VARCHAR(100) NOT NULL
);

CREATE TABLE IF NOT EXISTS products (
    product_id INTEGER PRIMARY KEY,
    product_name VARCHAR(150) NOT NULL,
    category VARCHAR(100) NOT NULL,
    unit_price NUMERIC(12, 2) NOT NULL CHECK (unit_price > 0)
);

CREATE TABLE IF NOT EXISTS orders (
    order_id INTEGER PRIMARY KEY,
    customer_id INTEGER NOT NULL,
    product_id INTEGER NOT NULL,
    order_date DATE NOT NULL,
    quantity INTEGER NOT NULL CHECK (quantity > 0),
    unit_price NUMERIC(12, 2) NOT NULL CHECK (unit_price > 0),
    payment_status VARCHAR(30) NOT NULL,
    order_status VARCHAR(30) NOT NULL,

    CONSTRAINT fk_order_customer
        FOREIGN KEY (customer_id)
        REFERENCES customers(customer_id),

    CONSTRAINT fk_order_product
        FOREIGN KEY (product_id)
        REFERENCES products(product_id)
);

SELECT SUM(total_amount) AS total_revenue FROM orders WHERE payment_status = 'paid' AND order_status = 'completed';
SELECT * FROM orders WHERE payment_status = 'paid' AND order_status = 'completed' ORDER BY total_amount DESC LIMIT 3;
SELECT o.product_id, p.product_name, SUM(total_amount) AS total_revenue FROM orders o INNER JOIN products p 
ON o.product_id = p.product_id GROUP BY o.product_id, p.product_name ORDER BY total_revenue DESC;
SELECT COUNT(*) AS order_count FROM orders WHERE payment_status = 'paid' AND order_status = 'completed';
SELECT c.customer_id, c.customer_name, c.email, c.city FROM customers c LEFT JOIN orders o
ON c.customer_id = o.customer_id WHERE o.order_id IS NULL;
SELECT p.product_id, p.product_name, p.category, p.unit_price FROM products p LEFT JOIN orders o
ON p.product_id = o.product_id WHERE o.order_id IS NULL;
